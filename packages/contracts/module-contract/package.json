{
  "name": "@webstir-io/module-contract",
  "version": "0.10.0",
  "description": "Public contract definitions for Webstir frontend and backend module providers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client-nav": {
      "types": "./dist/client-nav.d.ts",
      "import": "./dist/client-nav.js",
      "default": "./dist/client-nav.js"
    },
    "./render": {
      "types": "./dist/render-execute.d.ts",
      "import": "./dist/render-execute.js",
      "default": "./dist/render-execute.js"
    },
    "./page-routes": {
      "types": "./dist/page-routes.d.ts",
      "import": "./dist/page-routes.js",
      "default": "./dist/page-routes.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./ts-rest": {
      "types": "./dist/adapters/ts-rest.d.ts",
      "import": "./dist/adapters/ts-rest.js",
      "default": "./dist/adapters/ts-rest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "clean": "rm -rf dist schema",
    "build": "tsc -p tsconfig.json && bun scripts/build-schema.mjs",
    "build:types": "tsc -p tsconfig.json",
    "build:schema": "bun scripts/build-schema.mjs",
    "test": "bun run build && bun run test:built",
    "test:built": "tsc -p tsconfig.examples.json",
    "test:examples": "tsc -p tsconfig.examples.json"
  },
  "keywords": [
    "webstir",
    "contract",
    "modules"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webstir-io/webstir.git",
    "directory": "packages/contracts/module-contract"
  },
  "homepage": "https://github.com/webstir-io/webstir/tree/main/packages/contracts/module-contract#readme",
  "bugs": {
    "url": "https://github.com/webstir-io/webstir/issues"
  },
  "author": "Webstir",
  "dependencies": {
    "@ts-rest/core": "^3.40.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.21",
    "typescript": "^7.0.2",
    "zod-to-json-schema": "^3.23.3"
  }
}
