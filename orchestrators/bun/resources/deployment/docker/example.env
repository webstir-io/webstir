PORT=8080
NODE_ENV=production
SESSION_SECRET=replace-me-with-a-long-random-secret
# The address people use; required with sign-in, for the links it emails.
APP_URL=https://example.com
# Email over SMTP; required to send email in production.
# EMAIL_URL=smtp://user:password@smtp.example.com:587
# EMAIL_FROM=App <hello@example.com>
# The database and stored files live in /app/data unless these point elsewhere; mount a volume there.
# DATABASE_URL=postgres://user:password@host/database
# STORAGE_URL=s3://bucket
