# The server's settings. It reads the environment, then .env.local, then .env; copy this file to
# .env for local values, and keep secrets out of git.

# PORT=4321

# Signs session cookies and sign-in codes. Production requires a long random value; development
# makes one and keeps it in .webstir/.
# SESSION_SECRET=

# The address people use. Production requires it when the app has sign-in, for the links it emails.
# APP_URL=https://example.com

# The database: SQLite by default, or postgres://user:password@host/database.
# DATABASE_URL=file:./data/app.sqlite

# Email over SMTP (SES, Postmark, Resend, Mailgun, any mail server). In development, with no
# EMAIL_URL, email is printed and kept in .webstir/email.log.
# EMAIL_URL=smtp://user:password@smtp.example.com:587
# EMAIL_FROM=App <hello@example.com>

# File storage: local disk by default, or s3://bucket with the usual S3_* or AWS_* credentials.
# STORAGE_URL=file:./data/files

# Copies of a SQLite database after it changes: a folder, or s3://bucket/prefix. Off when unset.
# SNAPSHOT_URL=s3://my-app-backups/snapshots

# WEBSTIR_JOBS=off keeps this process from running scheduled and queued jobs.
