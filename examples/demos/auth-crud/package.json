{
  "name": "webstir-demo-auth-crud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Webstir auth and CRUD proof demo",
  "dependencies": {
    "@webstir-io/webstir-testing": "workspace:*",
    "@webstir-io/webstir-frontend": "workspace:*",
    "@webstir-io/webstir-backend": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.21",
    "autoprefixer": "10.5.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.1",
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari major versions",
    "iOS >= 14",
    "not dead"
  ],
  "webstir": {
    "mode": "full",
    "moduleManifest": {},
    "enable": {
      "clientNav": true
    }
  }
}
